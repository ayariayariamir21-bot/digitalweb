# =====================================================================
# ENVIRONMENT CLASSIFICATION
# SERVER_SECRET  — never prefixed with VITE_, never sent to the client,
#                  never logged. Required in production.
# SERVER_CONFIG  — server-only, non-secret configuration.
# PUBLIC_CLIENT_CONFIG (VITE_*) — embedded in the frontend bundle at build
#                  time, visible to anyone. Must never hold a secret.
# =====================================================================

# --- SERVER_SECRET ---
DATABASE_URL=
JWT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BUILT_IN_FORGE_API_KEY=

# --- SERVER_CONFIG ---
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000
PAYMENT_PROVIDER=stripe
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
BUILT_IN_FORGE_API_URL=
PRIVATE_STORAGE_ROOT=

# --- PUBLIC_CLIENT_CONFIG (safe to expose, not secrets) ---
# VITE_APP_ID: public application identifier sent to the OAuth portal.
VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL: public login page URL (navigation target only).
VITE_OAUTH_PORTAL_URL=

# Optional analytics embed (public endpoint + public website id).
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# NOTE: VITE_FRONTEND_FORGE_API_KEY / VITE_FRONTEND_FORGE_API_URL were
# removed (ETAPE 10 audit): no code in client/src or server/ ever read them,
# and any key shipped with a VITE_ prefix is public by construction. If a
# Forge key is ever needed, use the server-side BUILT_IN_FORGE_API_KEY only.
